# Example environment variables (DO NOT add real secrets here)
# Frontend (Vite) - only public keys
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# Stripe (publishable key for frontend)
# Vite requires environment variables to start with `VITE_`
VITE_STRIPE_PUBLISHABLE_KEY=

# (legacy) React-style variable kept for reference (do not use with Vite):
REACT_APP_STRIPE_PUBLISHABLE_KEY=

# Server-side / Functions (secret keys - DO NOT expose)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# URLs used by Stripe Checkout
SUCCESS_URL=http://localhost:5173/success
CANCEL_URL=http://localhost:5173/cart
